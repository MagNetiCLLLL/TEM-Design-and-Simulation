# Local environments, editor state and build/test products.
.idea/
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
build/
dist/

# Local binary dependency pool; retain wheels/README.md for setup_env.py.
/wheels/**/*.whl

# Generated calculations, screenshots, reports and scratch/reference downloads.
# Curated input settings, tests and original acquisitions live outside these.
/outputs/
/output/references/
/tmp/
/environment/
/.temsim-wave-cache/
*.temsection
*.temresult
*.temdiag

# Third-party reference originals and screenshots are local reading copies.
# Keep authored notes and source-link/hash metadata under version control.
/docs/references/**/*.pdf
/docs/references/**/*.html
/docs/references/**/*.htm
/docs/references/**/*.png
/docs/references/**/*.jpg
/docs/references/**/*.jpeg
/docs/references/**/*.gif
/docs/references/**/*.webp
/docs/references/**/*.tif
/docs/references/**/*.tiff
/docs/references/**/*.ppt
/docs/references/**/*.pptx
/docs/references/**/*.doc
/docs/references/**/*.docx
/docs/references/**/*.zip
/docs/references/local-only/

# Retain the immutable assembly regression fixture, not generated evidence.
/docs/development/evidence/*
!/docs/development/evidence/default-assembly-identity-map-v1.json
