# Preserve the original scientific reference CIF bytes.
configs/reference_samples/*.cif -text

# Preserve the accepted probe inputs, original particle weights and evidence hashes.
docs/development/probe_stage12_20261101/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/development/probe_a5_physical_20261101/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/development/probe_joint_20261101/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol

# Preserve the exact bytes used by the Microprobe source and observation hashes.
docs/development/microprobe_20261111/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
docs/development/microprobe_match_20261111/** -text whitespace=blank-at-eol,space-before-tab,cr-at-eol
# Generated SVG path whitespace belongs to the hashed observation artifacts.
docs/development/microprobe_match_20261111/beam-envelopes.svg -whitespace
docs/development/microprobe_match_20261111/illumination-footprints.svg -whitespace
scripts/optimize_joint_probe.py -text
scripts/report_joint_probe.py -text
tests/test_joint_probe_search.py -text

# Preserve the byte hashes recorded by the fixed-source A5 study.
scripts/calibrate_physical_a5.py -text
scripts/design_native_a5.py -text
scripts/polish_native_a5.py -text
scripts/report_physical_a5.py -text
tests/test_physical_a5_calibration.py -text

# Retain the source bytes of the accepted optical snapshot, including its EOF.
src/temsim/gui/crossover_survey_view.py whitespace=-blank-at-eof,blank-at-eol,space-before-tab,cr-at-eol

# Keep the scientific evidence byte-identical, including original CRLF endings.
docs/development/probe_tail_attribution_20261028/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve upstream license bytes and their inventory SHA-256 checksums.
/LICENSE -text
/licenses/*.txt -text
/third_party_licenses/packages/**/*.txt -text -whitespace
/third_party_licenses/upstream/*.txt -text -whitespace

# Local third-party reading copies must not enter source archives, even if a
# copy is accidentally force-added. Keep original bytes for local SHA checks.
docs/references/**/*.html -text -whitespace export-ignore
docs/references/**/*.htm -text -whitespace export-ignore
docs/references/**/*.pdf binary export-ignore
docs/references/**/*.png binary export-ignore
docs/references/**/*.jpg binary export-ignore
docs/references/**/*.jpeg binary export-ignore
docs/references/**/*.gif binary export-ignore
docs/references/**/*.webp binary export-ignore
docs/references/**/*.tif binary export-ignore
docs/references/**/*.tiff binary export-ignore
docs/references/**/*.ppt binary export-ignore
docs/references/**/*.pptx binary export-ignore
docs/references/**/*.doc binary export-ignore
docs/references/**/*.docx binary export-ignore
docs/references/**/*.zip binary export-ignore
docs/references/local-only export-ignore
output/references export-ignore
