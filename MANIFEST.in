# Local third-party reference copies are not part of the source distribution.
# Authored Markdown notes and source-link/hash metadata remain eligible.
include third_party_licenses/collect.py
recursive-exclude docs/references *.pdf *.html *.htm *.png *.jpg *.jpeg *.gif *.webp *.tif *.tiff *.ppt *.pptx *.doc *.docx *.zip
prune docs/references/local-only
prune output/references
